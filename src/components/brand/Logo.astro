---
/** Accessible, typography-based Valebrook Studio wordmark. */
interface Props {
  tone?: 'navy' | 'light';
  markOnly?: boolean;
  class?: string;
  title?: string;
}
const { tone = 'navy', markOnly = false, class: className = '', title = 'Valebrook Studio' } = Astro.props;
const ink = tone === 'navy' ? '#0B1F3A' : '#FAFAF7';
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox={markOnly ? '0 0 42 40' : '0 0 280 40'} class={className} role="img" aria-label={title} focusable="false">
  <path d="M5 8L19 33L33 8" fill="none" stroke={ink} stroke-width="5" stroke-linejoin="round" />
  <path d="M12 35H26" stroke="#D6AC65" stroke-width="3" />
  {!markOnly && (
    <g fill={ink}>
      <text x="46" y="23" font-family="Georgia, serif" font-size="21" font-weight="bold" letter-spacing="0.2">Valebrook</text>
      <text x="47" y="36" font-family="Arial, sans-serif" font-size="10" letter-spacing="3.4">STUDIO</text>
    </g>
  )}
</svg>
