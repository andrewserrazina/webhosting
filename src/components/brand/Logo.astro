---
/**
 * Northline Digital logo: geometric "N" mark with a north-pointing marker,
 * plus an outlined Fraunces wordmark (generated by scripts/build-logo.py).
 */
import wordmark from './wordmark.json';

interface Props {
  tone?: 'navy' | 'light';
  markOnly?: boolean;
  class?: string;
  title?: string;
}

const { tone = 'navy', markOnly = false, class: className = '', title = 'Northline Digital' } = Astro.props;
const ink = tone === 'navy' ? '#0B1F3A' : '#FAFAF7';
const [, , ww] = wordmark.viewBox;
const scale = 0.33;
const width = markOnly ? 40 : 50 + ww * scale;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${width.toFixed(1)} 40`}
  class={className}
  role="img"
  aria-label={title}
  focusable="false"
>
  <path fill={ink} d="M5 8h5.75v25H5zM5 8h5.75L34 33h-5.75zM28.25 13.5H34V33h-5.75z"></path>
  <path fill="#D6AC65" d="M31.125 1.5L37 12.5H25.25z"></path>
  {!markOnly && (
    <g transform={`translate(50 33) scale(${scale})`}>
      <path fill={ink} d={wordmark.northline} />
      <path fill={ink} d={wordmark.digital} />
    </g>
  )}
</svg>
