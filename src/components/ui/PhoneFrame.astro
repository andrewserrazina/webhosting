---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { src, alt, sizes = '(min-width: 1024px) 220px, 40vw', loading = 'lazy', class: className = '' } = Astro.props;
---

<figure
  class:list={[
    'overflow-hidden rounded-[2rem] border-[6px] border-navy bg-navy shadow-[0_30px_60px_-20px_rgb(11_31_58/0.55)]',
    className,
  ]}
>
  <div class="aspect-[390/780] overflow-hidden rounded-[1.6rem]">
    <Image
      src={src}
      alt={alt}
      widths={[240, 390, 560, 780].filter((w) => w <= src.width)}
      sizes={sizes}
      loading={loading}
      decoding="async"
      format="webp"
      quality={78}
      class="block h-full w-full object-cover object-top"
    />
  </div>
</figure>
