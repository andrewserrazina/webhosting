---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  label?: string;
  widths?: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
  class?: string;
  aspect?: string;
}
const {
  src,
  alt,
  label,
  widths = [480, 800, 1200, 1440],
  sizes,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
  aspect,
} = Astro.props;
---

<figure class:list={['browser-frame', className]}>
  <div class="browser-frame__bar" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    {label && <p class="ml-3 truncate text-[0.6875rem] font-medium text-slate-ink">{label}</p>}
  </div>
  <div class:list={['overflow-hidden', aspect]}>
    <Image
      src={src}
      alt={alt}
      widths={widths.filter((w) => w <= src.width)}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      format="webp"
      quality={78}
      class="block h-full w-full object-cover object-top"
    />
  </div>
</figure>
