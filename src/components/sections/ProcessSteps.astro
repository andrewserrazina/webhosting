---
import SectionHeading from '../ui/SectionHeading.astro';

const steps = [
  {
    title: 'Audit & discovery',
    body: 'We review your current website and online presence, learn how your business works, and understand what your customers need to see before they get in touch.',
  },
  {
    title: 'Plan & propose',
    body: 'You receive a clear recommendation and scope — what we’ll build, what it includes, and what it costs — before any work begins.',
  },
  {
    title: 'Design & build',
    body: 'We design and develop your site with regular check-ins, so you can see progress and give feedback along the way.',
  },
  {
    title: 'Launch & support',
    body: 'We test thoroughly, launch carefully, and make sure you know how everything works. Ongoing care is available if you want it.',
  },
];
---

<section class="py-24 lg:py-32" aria-labelledby="process-title">
  <div class="container-x">
    <SectionHeading
      id="process-title"
      eyebrow="How we work"
      title="A clear process, from first look to launch."
      intro="No jargon and no surprises. You’ll know what’s happening at every stage."
    />
    <ol class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="relative bg-paper p-8 lg:p-10" data-reveal>
          <span class="font-display block text-5xl text-gold-ink" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-8 text-2xl font-medium">
            <span class="sr-only">Step {i + 1}: </span>
            {step.title}
          </h3>
          <p class="mt-3 leading-relaxed text-slate-ink">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
