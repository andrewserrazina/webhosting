---
import { Wrench, PenTool, MessagesSquare, Briefcase, Layers } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';

const principles = [
  {
    icon: Wrench,
    title: 'Practical technology',
    body: 'We recommend tools and approaches that fit your business, your budget, and your team — not whatever is newest or most complicated.',
  },
  {
    icon: PenTool,
    title: 'Thoughtful design',
    body: 'Good design makes a business look credible and makes information easy to find. Every layout decision serves your customers.',
  },
  {
    icon: MessagesSquare,
    title: 'Clear communication',
    body: 'Plain language, honest timelines, and straightforward answers. You’ll always know what’s happening and why.',
  },
  {
    icon: Briefcase,
    title: 'Attention to business needs',
    body: 'A website is a business tool. We start with what you’re trying to achieve and build toward it.',
  },
  {
    icon: Layers,
    title: 'Long-term maintainability',
    body: 'We build clean, well-organized websites that are fast, secure, and easy to update for years — not just on launch day.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${site.url}/about` },
  ],
};
---

<BaseLayout
  title="About Northline Digital — Our Approach"
  description="Northline Digital is an independent web design and development agency built on practical technology, thoughtful design, clear communication, and maintainability."
  jsonLd={jsonLd}
>
  <section class="pt-16 pb-20 lg:pt-24 lg:pb-28" aria-labelledby="page-title">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="eyebrow text-gold-ink">About</p>
        <h1 id="page-title" class="mt-6 text-5xl leading-[1.03] font-medium sm:text-6xl lg:text-7xl">
          Better websites, built with care for the businesses behind them.
        </h1>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-white py-20 lg:py-28" aria-labelledby="story-title">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="story-title" class="eyebrow text-gold-ink">
          Who we are
        </h2>
      </div>
      <div class="prose-nl text-lg leading-relaxed text-slate-ink lg:col-span-8">
        <p class="font-display text-2xl leading-snug text-navy sm:text-3xl">
          Northline Digital is an independent digital agency helping small and growing businesses improve their
          websites, their online presence, and the technology they rely on every day.
        </p>
        <p>
          The agency was founded by an independent developer and entrepreneur with hands-on experience creating business
          websites and software platforms — from a complete website, email, and Google presence overhaul for a local
          stone fabricator to a real estate technology platform and a website for a specialized aviation training
          business.
        </p>
        <p>
          That mix matters. Building software products teaches you to think about how people actually use a website.
          Working with local businesses teaches you that every page has to earn its place by helping customers find you,
          trust you, and get in touch.
        </p>
        <p>
          When you work with Northline Digital, you work directly with the person designing and building your site. No
          hand-offs, no account managers, and no confusion about who’s responsible.
        </p>
      </div>
    </div>
  </section>

  <section class="py-24 lg:py-32" aria-labelledby="principles-title">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow text-gold-ink">Our approach</p>
        <h2 id="principles-title" class="mt-6 text-4xl leading-[1.05] font-medium sm:text-5xl lg:text-[3.5rem]">
          What guides every project.
        </h2>
      </div>
      <ul class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {principles.map(({ icon: Icon, title, body }) => (
          <li class="bg-paper p-8 lg:p-10" data-reveal>
            <Icon class="size-6 text-gold-ink" aria-hidden="true" />
            <h3 class="mt-8 text-2xl font-medium">{title}</h3>
            <p class="mt-3 leading-relaxed text-slate-ink">{body}</p>
          </li>
        ))}
        <li class="flex flex-col justify-between bg-navy p-8 text-paper lg:p-10">
          <p class="font-display text-2xl leading-snug">See these principles in practice.</p>
          <div class="mt-8">
            <Button href="/work" variant="gold" arrow>
              Explore our work
            </Button>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-white py-20 lg:py-24" aria-labelledby="who-title">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="who-title" class="eyebrow text-gold-ink">
          Who we work with
        </h2>
      </div>
      <div class="lg:col-span-8">
        <ul class="font-display grid gap-x-10 text-2xl sm:grid-cols-2 sm:text-3xl">
          {[
            'Local service businesses',
            'Contractors & home improvement',
            'Professional service providers',
            'Small & medium-sized businesses',
          ].map((item) => (
            <li class="border-b border-line py-5">{item}</li>
          ))}
        </ul>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-slate-ink">
          If your website is outdated, hard to use on a phone, or simply not bringing in inquiries, we can help. Recent
          projects include{' '}
          {projects.map((p, i) => (
            <>
              <a href={`/work/${p.slug}`} class="link-underline font-semibold text-navy">
                {p.name}
              </a>
              {i < projects.length - 2 ? ', ' : i === projects.length - 2 ? ', and ' : '.'}
            </>
          ))}
        </p>
      </div>
    </div>
  </section>

  <CtaBand title="Let’s talk about your website." />
</BaseLayout>
