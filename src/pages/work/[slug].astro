---
import type { GetStaticPaths } from 'astro';
import { ArrowLeft, ArrowRight, ArrowUpRight, Check } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import BrowserFrame from '../../components/ui/BrowserFrame.astro';
import PhoneFrame from '../../components/ui/PhoneFrame.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { projects, type Project } from '../../data/projects';
import { site } from '../../data/site';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/work` },
      { '@type': 'ListItem', position: 3, name: project.name, item: `${site.url}/work/${project.slug}` },
    ],
  },
];
---

<BaseLayout title={project.seoTitle} description={project.seoDescription} type="article" jsonLd={jsonLd}>
  <article>
    <header class="pt-10 pb-16 lg:pt-14 lg:pb-20">
      <div class="container-x">
        <nav aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-slate-ink">
            <li>
              <a href="/work" class="link-underline inline-flex items-center gap-1.5">
                <ArrowLeft class="size-3.5" aria-hidden="true" />
                Work
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="font-medium text-navy">
              {project.name}
            </li>
          </ol>
        </nav>
        <div class="mt-12 grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-8">
            <p class="eyebrow text-gold-ink">{project.category}</p>
            <h1 class="mt-6 text-5xl leading-[1.02] font-medium sm:text-6xl lg:text-7xl">{project.name}</h1>
            <p class="mt-8 max-w-2xl text-xl leading-relaxed text-slate-ink">{project.summary}</p>
          </div>
          <dl class="grid grid-cols-2 gap-6 self-end border-t border-line pt-6 text-sm lg:col-span-4 lg:grid-cols-1">
            <div>
              <dt class="font-semibold tracking-[0.14em] text-navy uppercase">Industry</dt>
              <dd class="mt-1 text-slate-ink">{project.industry}</dd>
            </div>
            <div>
              <dt class="font-semibold tracking-[0.14em] text-navy uppercase">Website</dt>
              <dd class="mt-1">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline inline-flex items-center gap-1 font-medium text-navy"
                >
                  {project.displayUrl}
                  <ArrowUpRight class="size-3.5" aria-hidden="true" />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </dd>
            </div>
            {project.status && (
              <div class="col-span-2 lg:col-span-1">
                <dt class="font-semibold tracking-[0.14em] text-navy uppercase">Status</dt>
                <dd class="mt-1 text-slate-ink">{project.status}</dd>
              </div>
            )}
          </dl>
        </div>
      </div>
    </header>

    <div class="relative">
      <div class="absolute inset-x-0 top-1/3 bottom-0 bg-navy" aria-hidden="true"></div>
      <div class="container-x relative">
        <BrowserFrame
          src={project.images.desktop}
          alt={project.imageAlt.desktop}
          label={project.displayUrl}
          sizes="(min-width: 1312px) 1216px, 94vw"
          loading="eager"
          fetchpriority="high"
          widths={[640, 960, 1280, 1440]}
          aspect="aspect-[16/10]"
        />
      </div>
    </div>

    <section class="bg-navy pt-20 pb-24 text-paper lg:pt-28 lg:pb-32" aria-labelledby="overview-title">
      <div class="container-x grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 id="overview-title" class="eyebrow text-gold">
            Overview
          </h2>
          <h3 class="mt-8 font-sans text-xs font-semibold tracking-[0.18em] text-paper uppercase">
            Services delivered
          </h3>
          <ul class="mt-5 space-y-3">
            {project.services.map((s) => (
              <li class="flex gap-3 text-mist">
                <Check class="mt-1 size-4 shrink-0 text-gold" aria-hidden="true" />
                {s}
              </li>
            ))}
          </ul>
        </div>
        <div class="prose-nl text-xl leading-relaxed text-mist lg:col-span-8 [&>p:first-child]:text-paper [&>p:first-child]:font-display [&>p:first-child]:text-2xl sm:[&>p:first-child]:text-3xl [&>p:first-child]:leading-snug">
          {project.overview.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>
    </section>

    {project.results && (
      <section class="border-b border-line bg-paper-200 py-20 lg:py-24" aria-labelledby="results-title">
        <div class="container-x">
          <p class="eyebrow text-gold-ink">Measured performance</p>
          <h2 id="results-title" class="mt-5 text-4xl font-medium sm:text-5xl">What changed after the redesign period</h2>
          <p class="mt-5 max-w-3xl text-slate-ink">Comparing April–June 2026 with July–September 2026.</p>
          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {project.results.map((metric) => (
              <div class="rounded-xl border border-line bg-white p-6">
                <p class="text-sm font-semibold text-slate-ink">{metric.label}</p>
                <p class="mt-4 text-4xl font-semibold text-navy">{metric.change}</p>
                <p class="mt-3 text-sm text-slate-ink">{metric.before} → {metric.after}</p>
              </div>
            ))}
          </div>
          <p class="mt-6 max-w-4xl text-sm leading-relaxed text-slate-ink">{project.resultsNote}</p>
        </div>
      </section>
    )}

    <section class="py-24 lg:py-32" aria-labelledby="goals-title">
      <div class="container-x grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-gold-ink">The brief</p>
          <h2 id="goals-title" class="mt-6 text-4xl font-medium sm:text-5xl">
            Project goals
          </h2>
        </div>
        <ol class="space-y-0 divide-y divide-line border-y border-line lg:col-span-8">
          {project.goals.map((goal, i) => (
            <li class="flex gap-6 py-6 text-lg leading-relaxed" data-reveal>
              <span class="font-display w-8 shrink-0 text-gold-ink" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>{goal}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="border-t border-line bg-white py-24 lg:py-32" aria-labelledby="delivered-title">
      <div class="container-x">
        <div class="max-w-3xl">
          <p class="eyebrow text-gold-ink">What we delivered</p>
          <h2 id="delivered-title" class="mt-6 text-4xl font-medium sm:text-5xl">
            Built around how customers decide.
          </h2>
        </div>
        <ul class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2 lg:grid-cols-3">
          {project.delivered.map((d) => (
            <li class="bg-white p-8 lg:p-10" data-reveal>
              <h3 class="text-2xl font-medium">{d.title}</h3>
              <p class="mt-3 leading-relaxed text-slate-ink">{d.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-paper-200 py-24 lg:py-32" aria-labelledby="gallery-title">
      <div class="container-x">
        <h2 id="gallery-title" class="eyebrow text-gold-ink">
          Desktop &amp; mobile
        </h2>
        <div class="mt-10 grid items-start gap-10 lg:grid-cols-12">
          <div class="lg:col-span-9">
            <BrowserFrame
              src={project.images.long}
              alt={project.imageAlt.long}
              label={project.displayUrl}
              sizes="(min-width: 1312px) 900px, (min-width: 1024px) 70vw, 94vw"
              widths={[640, 960, 1280, 1440]}
              aspect="aspect-[1440/1500]"
            />
          </div>
          <div class="mx-auto w-2/3 max-w-[280px] sm:w-1/2 lg:col-span-3 lg:w-full lg:pt-24">
            <PhoneFrame
              src={project.images.mobile}
              alt={project.imageAlt.mobile}
              sizes="(min-width: 1024px) 260px, 60vw"
            />
          </div>
        </div>
        <p class="mt-8 text-sm text-slate-ink">
          Screenshots of the live website at {project.displayUrl}. Site content belongs to its owner.
        </p>
      </div>
    </section>

    <section class="py-24 lg:py-32" aria-labelledby="approach-title">
      <div class="container-x grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-gold-ink">Our approach</p>
          <h2 id="approach-title" class="mt-6 text-4xl font-medium sm:text-5xl">
            How we thought about it
          </h2>
        </div>
        <div class="prose-nl text-lg leading-relaxed text-slate-ink lg:col-span-8">
          {project.approach.map((p) => (
            <p>{p}</p>
          ))}
          <div class="pt-6">
            <Button href={project.url} variant="outline" external>
              Visit {project.displayUrl}
              <ArrowUpRight class="size-4" aria-hidden="true" />
            </Button>
          </div>
        </div>
      </div>
    </section>
  </article>

  <nav aria-label="Next project" class="border-t border-line">
    <a href={`/work/${next.slug}`} class="group container-x flex items-center justify-between gap-6 py-14 lg:py-20">
      <span>
        <span class="text-xs font-semibold tracking-[0.18em] text-slate-ink uppercase">Next project</span>
        <span class="font-display mt-3 block text-4xl font-medium sm:text-5xl">{next.name}</span>
      </span>
      <span class="inline-flex size-14 shrink-0 items-center justify-center rounded-full border border-navy/25 transition-colors group-hover:bg-navy group-hover:text-paper">
        <ArrowRight class="size-5" aria-hidden="true" />
      </span>
    </a>
  </nav>

  <CtaBand />
</BaseLayout>
