---
import { Check, ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import { services, careService } from '../data/services';
import { site } from '../data/site';

const all = [...services, careService];

const faqs = [
  {
    q: 'How much will my project cost?',
    a: 'A focused one-page refresh is offered at $199 subject to scope review; full website overhauls start at $1,500. New websites, digital solutions, and care plans are quoted individually. Final pricing always depends on the scope of the project and its technical requirements — such as the number of pages, content needs, and any integrations. You’ll receive a clear written scope and price before any work begins.',
  },
  {
    q: 'What does the free website audit include?',
    a: 'We review your current website’s design, mobile experience, loading speed, basic search engine setup, accessibility, and how easy it is for visitors to contact you. You’ll get practical, plain-language recommendations. There’s no obligation to work with us afterward.',
  },
  {
    q: 'I don’t have a website yet. Can you still help?',
    a: 'Yes. Our new website development service is designed for businesses starting fresh. We’ll help you plan the structure and content, then design and build the site.',
  },
  {
    q: 'Can you work with my existing domain, hosting, and email?',
    a: 'Usually, yes. We’ll review your current setup as part of the project and recommend whether to keep it, improve it, or move to something more reliable — and explain why.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Website Design, Overhauls & Digital Services"
  description="One-page website refreshes at $199 and full overhauls starting at $1,500, custom website development, business email and Google Business Profile help, and ongoing website care from Valebrook Studio."
  jsonLd={jsonLd}
>
  <section class="pt-16 pb-20 lg:pt-24 lg:pb-24" aria-labelledby="page-title">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="eyebrow text-gold-ink">Services</p>
        <h1 id="page-title" class="mt-6 text-5xl leading-[1.03] font-medium sm:text-6xl lg:text-7xl">
          Everything your business needs to look its best online.
        </h1>
      </div>
      <div class="lg:col-span-4 lg:self-end">
        <p class="text-lg leading-relaxed text-slate-ink">
          From rebuilding an outdated site to setting up professional email, every project is scoped around your
          business and what your customers need.
        </p>
      </div>
    </div>
    <nav aria-label="Services on this page" class="container-x mt-14">
      <ul class="flex flex-wrap gap-3">
        {all.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2 text-sm font-medium transition-colors hover:border-navy"
            >
              <span class="text-gold-ink">{s.number}</span>
              {s.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <div class="border-t border-line">
    {all.map((service, i) => (
      <section
        id={service.id}
        aria-labelledby={`${service.id}-title`}
        class:list={['scroll-mt-24 border-b border-line py-20 lg:py-28', i % 2 === 1 && 'bg-white']}
      >
        <div class="container-x grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <span class="font-display text-2xl text-gold-ink" aria-hidden="true">
              {service.number}
            </span>
            <h2 id={`${service.id}-title`} class="mt-4 text-4xl leading-[1.05] font-medium sm:text-5xl">
              {service.title}
            </h2>
            <p class="mt-6 inline-flex rounded-full bg-navy px-4 py-2 text-sm font-semibold text-paper">
              {service.price}
            </p>
            {service.priceNote && <p class="mt-3 text-sm text-slate-ink">{service.priceNote}</p>}
            <p class="mt-8 text-lg leading-relaxed text-slate-ink">{service.summary}</p>
            <div class="mt-8">
              <Button href={service.cta.href} variant={i === 0 ? 'gold' : 'navy'} arrow>
                {service.cta.label}
              </Button>
            </div>
          </div>
          <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7 lg:pl-8">
            <div>
              <h3 class="font-sans text-xs font-semibold tracking-[0.18em] text-navy uppercase">What’s included</h3>
              <ul class="mt-6 space-y-4">
                {service.includes.map((item) => (
                  <li class="flex gap-3 leading-relaxed text-slate-ink">
                    <Check class="mt-1 size-4 shrink-0 text-gold-ink" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="font-sans text-xs font-semibold tracking-[0.18em] text-navy uppercase">A good fit if</h3>
              <ul class="mt-6 space-y-4">
                {service.goodFit.map((item) => (
                  <li class="flex gap-3 leading-relaxed text-slate-ink">
                    <ArrowRight class="mt-1 size-4 shrink-0 text-gold-ink" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="py-20 lg:py-24" aria-labelledby="pricing-title">
    <div class="container-x">
      <div class="rounded-2xl border border-line bg-paper-200 p-8 sm:p-12 lg:flex lg:items-center lg:gap-16">
        <div class="lg:w-1/2">
          <h2 id="pricing-title" class="text-3xl font-medium sm:text-4xl">
            A note on pricing
          </h2>
        </div>
        <p class="mt-6 text-lg leading-relaxed text-slate-ink lg:mt-0 lg:w-1/2">
          Listed starting prices are a guide. Final project pricing depends on scope and technical requirements, and
          you’ll always receive a written proposal before any work begins — no surprises.
        </p>
      </div>
    </div>
  </section>

  <div class="border-t border-line"></div>
  <ProcessSteps />

  <section class="border-t border-line bg-white py-24 lg:py-32" aria-labelledby="faq-title">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow text-gold-ink">FAQ</p>
        <h2 id="faq-title" class="mt-6 text-4xl font-medium sm:text-5xl">
          Common questions
        </h2>
      </div>
      <div class="divide-y divide-line border-y border-line lg:col-span-8">
        {faqs.map((f) => (
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-xl font-medium [&::-webkit-details-marker]:hidden">
              <span class="font-display">{f.q}</span>
              <span
                class="relative size-5 shrink-0 before:absolute before:top-1/2 before:left-0 before:h-px before:w-5 before:bg-navy after:absolute after:top-0 after:left-1/2 after:h-5 after:w-px after:bg-navy after:transition-transform group-open:after:scale-y-0"
                aria-hidden="true"
              />
            </summary>
            <p class="mt-4 max-w-2xl leading-relaxed text-slate-ink">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
