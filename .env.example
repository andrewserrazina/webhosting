# ---------------------------------------------------------------------------
# Valebrook Studio — environment configuration
# Copy to `.env` for local `astro dev`/`astro build`, and to `.dev.vars` for
# `wrangler pages dev`. In production, set these in Cloudflare Pages →
# Settings → Variables and Secrets. NEVER commit real values.
# ---------------------------------------------------------------------------

# ---- Build-time (public, baked into static HTML; safe to expose) ----------
# Canonical production origin, no trailing slash.
PUBLIC_SITE_URL=https://example.com
# Public contact email shown on the site. Leave empty to hide it.
PUBLIC_CONTACT_EMAIL=
# Cloudflare Turnstile site key (optional but recommended). Leave empty to
# disable the widget; honeypot + timing checks still apply.
PUBLIC_TURNSTILE_SITE_KEY=

# ---- Runtime (Pages Functions; set as encrypted secrets) -------------------
# Email provider used to deliver contact form notifications: "resend" or "postmark".
EMAIL_PROVIDER=resend
# API key for the chosen provider (Resend API key or Postmark server token).
EMAIL_API_KEY=
# Inbox that receives new inquiries.
CONTACT_TO_EMAIL=
# Verified sender address on your provider, e.g. "Valebrook Studio <forms@yourdomain.com>".
CONTACT_FROM_EMAIL=
# Turnstile secret key. Required if PUBLIC_TURNSTILE_SITE_KEY is set.
TURNSTILE_SECRET_KEY=
# Allowed origin(s) for form posts, comma-separated. Defaults to PUBLIC_SITE_URL.
ALLOWED_ORIGINS=
# Max submissions per IP per window (default 5 per 600 seconds).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
